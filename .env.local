# Database
DATABASE_URL="postgresql://username:password@localhost:5432/carrier_verification?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# FMCSA API (You'll need to register for real API access)
FMCSA_API_KEY="your-fmcsa-api-key"
FMCSA_BASE_URL="https://mobile.fmcsa.dot.gov/qc/services/carriers"

# Document Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760 # 10MB

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# OCR Service (Tesseract.js is client-side, but you might want cloud OCR)
GOOGLE_CLOUD_VISION_API_KEY="your-google-vision-api-key"

# Insurance Verification APIs
INSURANCE_VERIFICATION_API_KEY="your-insurance-api-key"

# Risk Scoring
RISK_SCORING_ENABLED=true

# Cron Jobs
AUTO_REFRESH_FMCSA_DATA=true
REFRESH_INTERVAL_HOURS=24

